{
  "id": "media-generator",
  "title": "图片生成",
  "category": "image",
  "description": "输入一段文字，生成512x512的图片",
  "version": "0.1.0",
  "preview_video": "/static/apps/media-generator/preview.mp4",
  "preview_image": "",
  "software_capabilities": [
    "swcap_text_to_image"
  ],
  "hardware_capabilities": [],
  "backend": {
    "module": "wdnapps_media_generator.cards.media_generator",
    "register_api": "register_api",
    "register_shutdown": "register_shutdown"
  },
  "frontend": {
    "template": "/static/apps/media-generator/template.html",
    "js": [
      "/static/apps/media-generator/app.js"
    ],
    "css": [
      "/static/apps/media-generator/app.css"
    ]
  },
  "demo_guard": {
    "active_state_keys": [
      "session.busy",
      "session.running",
      "session.state"
    ],
    "stop_endpoints": [
      {
        "method": "POST",
        "path": "/api/media-generator/stop"
      }
    ],
    "stop_sync_endpoints": [
      {
        "method": "POST",
        "path": "/api/media-generator/stop"
      }
    ]
  },
  "prompts": {
    "schema_class": "",
    "editable_fields": [],
    "prompt_template": ""
  },
  "requires_core": [
    "compute.registry"
  ],
  "uploads_dir": "uploads/media_generator",
  "display_order": 65,
  "wizard_config": "wizard.json"
}
